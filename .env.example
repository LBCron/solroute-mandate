# Optional: MultiHopper API key (mh_test_... for Devnet or mh_live_... for Mainnet).
# Omit to run in deterministic Sandbox Signer mode with zero external API keys required.
MH_API_KEY=

# Optional: Base58 or JSON array Solana keypair for client-side partial signing.
# Omit to generate an ephemeral in-memory signer for sandbox testing.
SOLANA_PRIVATE_KEY=

# Solana RPC endpoint used for live Mainnet Anchor program verification & tx broadcast
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# HMAC-SHA256 secret for verifying incoming x-multihopper-signature webhooks
MH_WEBHOOK_SECRET=whsec_replace_with_your_endpoint_secret

# HTTP Cockpit & MCP JSON-RPC port
PORT=4173
